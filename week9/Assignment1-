    vector<Employee> employees = {
        {"Alice Chen",    Department::ENGINEERING, 42.00, 45.0}, // overtime
        {"Bob Martinez",  Department::SALES,       28.00, 38.0},
        {"Carol Singh",   Department::HR,          32.50, 35.0}, // fractional rate
        {"David Park",    Department::ENGINEERING, 50.00, 38.0},
        {"Emma Wilson",   Department::OPERATIONS,  29.00, 30.0},
        {"Frank Torres",  Department::SALES,       44.50, 45.0}, // overtime & fractional rate
        {"Grace Kim",     Department::HR,          33.50, 33.0}, // fractional rate
        {"Henry Okafor",  Department::OPERATIONS,  55.00, 29.0}
    };

    cout << "=== HR Time Tracker ===\n";

    // Validate sample inputs
    cout << "\nValidating hours entry -5: " << (validHours(-5) ? "valid" : "invalid") << "\n";
    cout << "Validating hours entry 45: " << (validHours(45) ? "valid" : "invalid") << "\n";

    // Regular tracking and total breakdown evaluations
    displayAll(employees);
    cout << "\nTotal payroll this week: $" << fixed << setprecision(2) << totalPayroll(employees) << "\n";

    // Feature Implementations
    sortByHours(employees);
    getDepartmentStats(employees, Department::ENGINEERING);
    exportPayrollReport(employees, "payroll_report.txt");
    
    // Bonus Challenge execution
    findHighEarners(employees, 1800.00);

    return 0;
}
